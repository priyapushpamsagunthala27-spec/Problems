bool isValid(char* s) {
    int len = strlen(s);
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        
        // If opening bracket, push to stack
        if (s[i] == '(' || s[i] == '{' || s[i] == '[') {
            stack[++top] = s[i];
        }
        else {
            // If stack empty → invalid
            if (top == -1) {
                free(stack);
                return false;
            }
            char topElement = stack[top--];
            if ((s[i] == ')' && topElement != '(') ||
                (s[i] == '}' && topElement != '{') ||
                (s[i] == ']' && topElement != '[')) {           
                free(stack);
                return false;
            }
        }
    }   
    bool result = (top == -1);
    free(stack);
    return result;
}
